# Banco de dados — em produção (Supabase, Render, Railway, Vercel...) use
# DATABASE_URL com a connection string pronta que o provedor te dá; ela
# tem prioridade sobre as variáveis DB_* abaixo. Rodando na Vercel, use a
# connection string de "Connection pooling" do Supabase (porta 6543), não
# a direta (porta 5432) — serverless abre muitas conexões curtas e a
# direta tem um limite bem menor.
DATABASE_URL=

# DB_* — usadas só quando DATABASE_URL não está definida (ex.: rodando
# localmente com Docker/Postgres na sua máquina).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konectaja
DB_USER=postgres
DB_PASSWORD=

# Autenticação
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_ADMIN=8h

# Login com Google — sem essa chave, POST /api/auth/google responde 503
# e o app cai de volta pro login normal. Precisa ser o MESMO Client ID
# (tipo "Web application") usado no front (VITE_GOOGLE_CLIENT_ID no
# web-app, e o equivalente Android/iOS no mobile).
GOOGLE_CLIENT_ID=

# Notificações push (Firebase) — sem essa chave, mensagens/propostas/
# avaliações continuam funcionando normal, só não saem as notificações
# (fica só registrado em log). Conteúdo do JSON da conta de serviço
# (Firebase Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada), colado direto aqui (ou em base64, se o
# provedor de deploy não aceitar JSON com quebra de linha na variável).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Upload de fotos (foto de perfil, álbum de trabalhos) via Vercel Blob —
# sem essa chave, os endpoints de upload respondem com erro claro, sem
# quebrar o resto do app. Pra gerar: no dashboard da Vercel, no projeto
# do backend, aba Storage > Create Database > Blob — ela já conecta essa
# variável automaticamente, não precisa copiar/colar nada.
BLOB_READ_WRITE_TOKEN=

# Asaas (pagamentos) — sem essas chaves, o app funciona normalmente,
# só a cobrança automática do prestador fica pendente (fica registrada
# em `pagamentos` sem asaas_id até você configurar isso)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Servidor
PORT=3333

# CORS em produção: lista separada por vírgula das origens permitidas
# (o site do cliente/prestador e o painel admin). Deixe vazio em dev —
# libera qualquer origem.
CORS_ORIGINS=
