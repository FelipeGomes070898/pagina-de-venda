# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vexo
DB_USER=postgres
DB_PASSWORD=

# Autenticação
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_ADMIN=8h

# Login com Google — sem essa chave, POST /api/auth/google responde 503
# e o app cai de volta pro login normal. Precisa ser o MESMO Client ID
# (tipo "Web application") usado no front (VITE_GOOGLE_CLIENT_ID no
# web-app, e o equivalente Android/iOS no mobile).
GOOGLE_CLIENT_ID=

# Asaas (pagamentos) — sem essas chaves, o app funciona normalmente,
# só a cobrança automática do prestador fica pendente (fica registrada
# em `pagamentos` sem asaas_id até você configurar isso)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Servidor
PORT=3333

# CORS em produção: lista separada por vírgula das origens permitidas
# (o site do cliente/prestador e o painel admin). Deixe vazio em dev —
# libera qualquer origem.
CORS_ORIGINS=
