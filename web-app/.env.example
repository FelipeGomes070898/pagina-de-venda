VITE_API_URL=http://localhost:3333

# Sem essas duas, o app funciona normalmente: o botão do Google some
# (login/cadastro continuam por telefone/e-mail/CPF), e o campo de
# endereço vira um input de texto comum (sem sugestões nem lat/lng).

# Client ID tipo "Web application" no Google Cloud Console — precisa
# ser o MESMO configurado em GOOGLE_CLIENT_ID no backend.
VITE_GOOGLE_CLIENT_ID=

# Chave da Maps JavaScript API (biblioteca Places habilitada), restrita
# por HTTP referrer no Google Cloud Console pro domínio do site.
VITE_GOOGLE_MAPS_API_KEY=
